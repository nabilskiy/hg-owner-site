---
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { appUrl } from '@/config/site';
import type { Locale } from '@/i18n/config';
import { localizedPath, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const section = useTranslations(lang)('finalCta');
---

<section id="final-cta" class="py-12 md:py-20">
  <Container>
    {/* TODO: implement visual */}
    <SectionHeading align="center" title={section.title} description={section.description} />
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href={appUrl()}>{section.startSelling}</Button>
      <Button href={localizedPath(lang, '/#ecosystem')} variant="secondary">
        {section.seeHow}
      </Button>
    </div>
  </Container>
</section>
