---
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';
import FeatureCarousel from '@/sections/beyond-basics/islands/FeatureCarousel';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const section = t('beyondBasics');
const common = t('common');
const cards = section.cards.map((card) => ({
  title: card.title,
  body: card.body ?? '',
  points: card.points,
}));
---

<section id="beyond-basics" class="py-12 md:py-20">
  <Container>
    <SectionHeading title={section.eyebrow} />
    {/* TODO: implement visual */}
    <div class="mt-8">
      <FeatureCarousel
        client:visible
        label={section.label}
        previousLabel={common.previous}
        nextLabel={common.next}
        cards={cards}
      />
    </div>
  </Container>
</section>
