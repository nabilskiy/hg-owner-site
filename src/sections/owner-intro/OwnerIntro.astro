---
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = useTranslations(lang)('ownerIntro');
---

<section id="owner-intro" class="bg-canvas" data-owner-intro>
  <div data-track class="relative h-[170vh]">
    <div class="sticky top-0 flex h-svh items-start">
      <div class="relative mx-auto w-full max-w-[1440px] px-8 pt-[18vh] lg:px-[84px] lg:pt-[14vh]">
        <p
          data-ghost
          class="text-[40px] leading-[0.9] font-medium tracking-[-0.04em] text-white lg:text-[150px] lg:leading-[0.85]"
        >
          {copy.ghostLines[0]}
          <br />
          {copy.ghostLines[1]}
        </p>
        <h2
          data-ink
          class="relative z-10 mt-4 text-[32px] leading-[1.05] font-semibold tracking-[-0.03em] text-ink lg:mt-8 lg:text-[78px] lg:leading-[0.95]"
        >
          {copy.titleLines[0]}
          <br />
          {copy.titleLines[1]}
        </h2>
      </div>
    </div>
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function setup(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const ghost = root.querySelector<HTMLElement>('[data-ghost]');
    const ink = root.querySelector<HTMLElement>('[data-ink]');
    if (!track || !ghost || !ink) return;

    let rise = 0;

    const measure = () => {
      rise = Math.max(ink.offsetTop - ghost.offsetTop - 12, 0);
    };

    const update = () => {
      if (reduceMotion.matches) {
        ink.style.transform = '';
        ghost.style.filter = '';
        return;
      }

      const rect = track.getBoundingClientRect();
      const travel = Math.max(track.offsetHeight - window.innerHeight, 0);
      const passed = Math.min(Math.max(-rect.top, 0), travel);
      const progress = travel === 0 ? 0 : passed / travel;
      ink.style.transform = `translate3d(0, ${(-rise * progress).toFixed(2)}px, 0)`;
      ghost.style.filter = progress > 0.01 ? `blur(${(progress * 6).toFixed(2)}px)` : '';
    };

    measure();
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener(
      'resize',
      () => {
        measure();
        update();
      },
      { passive: true },
    );
    reduceMotion.addEventListener('change', update);
  }

  document.querySelectorAll<HTMLElement>('[data-owner-intro]').forEach(setup);
</script>
