---
import Card from '@/components/ui/Card.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const section = useTranslations(lang)('testimonials');
---

<section id="testimonials" class="py-12 md:py-20">
  <Container>
    <SectionHeading eyebrow={section.eyebrow} title={section.title} />
    {/* TODO: implement visual */}
    <ul class="mt-8 grid gap-4 lg:grid-cols-3">
      {section.items.map((item) => (
        <li>
          <Card>
            <blockquote>
              <p>{item.quote}</p>
              <footer class="mt-4">
                <p class="font-semibold">{item.name}</p>
                <p class="text-sm text-muted">{item.role}</p>
                <p class="text-sm text-muted">{item.category}</p>
              </footer>
            </blockquote>
          </Card>
        </li>
      ))}
    </ul>
  </Container>
</section>
