---
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = useTranslations(lang)('effect');

const markColors = [
  '#02183d',
  '#02183d',
  '#02183d',
  '#02183d',
  '#02183d',
  '#02183d',
  '#02183d',
  '#1ab5c1',
  '#f9b953',
  '#f36434',
];

const cardTones: Record<string, string> = {
  blue: 'bg-[#e6f4f5] justify-center',
  pink: 'bg-[#f7d8d2] justify-center',
  cream: 'bg-[#efefda] justify-start pt-6',
};
---

<section id="effect" class="bg-canvas" data-effect>
  <div data-track class="relative h-[170vh]">
    <div class="sticky top-0 h-svh">
      <div class="relative mx-auto h-full max-w-[1440px]">
        <div class="px-8 pt-[10vh] lg:px-[84px] lg:pt-[12vh]">
          <p
            data-ghost
            class="text-[40px] leading-none font-medium tracking-[-0.04em] text-[#e4e8e8] lg:text-[150px]"
          >
            {copy.ghostLines.map((line, index) => (
              <>
                {index > 0 && <br />}
                {line}
              </>
            ))}
          </p>
          <h2
            data-ink
            class="relative z-10 mt-4 text-[32px] leading-[1.05] font-semibold tracking-[-0.03em] text-ink lg:mt-6 lg:text-[64px]"
          >
            {copy.lead}
            {copy.mark.split('').map((letter, index) => (
              <span style={`color: ${markColors[index] ?? 'inherit'}`}>{letter}</span>
            ))}
            {copy.tail}
          </h2>
        </div>
        <ul class="absolute right-8 bottom-8 left-8 grid gap-4 sm:grid-cols-3 lg:right-auto lg:bottom-12 lg:left-1/2 lg:w-[947px] lg:-translate-x-1/2 lg:grid-cols-3 lg:gap-[25px]">
          {copy.stats.map((stat) => (
            <li
              class:list={[
                'flex h-[148px] flex-col items-end rounded-3xl px-6 pb-6 text-right lg:h-[174px]',
                cardTones[stat.tone],
              ]}
            >
              <p class="text-[28px] leading-none font-semibold tracking-[-0.03em] text-ink">
                {stat.value}
              </p>
              <p class="mt-2 max-w-[16rem] text-sm leading-snug text-ink">{stat.label}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function setup(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const ghost = root.querySelector<HTMLElement>('[data-ghost]');
    const ink = root.querySelector<HTMLElement>('[data-ink]');
    if (!track || !ghost || !ink) return;

    let rise = 0;

    const measure = () => {
      rise = Math.max(ink.offsetTop - ghost.offsetTop - 12, 0);
    };

    const update = () => {
      if (reduceMotion.matches) {
        ink.style.transform = '';
        ghost.style.filter = '';
        return;
      }

      const rect = track.getBoundingClientRect();
      const travel = Math.max(track.offsetHeight - window.innerHeight, 0);
      const passed = Math.min(Math.max(-rect.top, 0), travel);
      const progress = travel === 0 ? 0 : passed / travel;
      ink.style.transform = `translate3d(0, ${(-rise * progress).toFixed(2)}px, 0)`;
      ghost.style.filter = progress > 0.01 ? `blur(${(progress * 6).toFixed(2)}px)` : '';
    };

    measure();
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener(
      'resize',
      () => {
        measure();
        update();
      },
      { passive: true },
    );
    reduceMotion.addEventListener('change', update);
  }

  document.querySelectorAll<HTMLElement>('[data-effect]').forEach(setup);
</script>
