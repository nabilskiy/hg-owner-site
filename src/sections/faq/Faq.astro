---
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { externalLinks } from '@/config/site';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';
import FaqAccordion from '@/sections/faq/islands/FaqAccordion';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const section = useTranslations(lang)('faq');
const answered = section.items.flatMap((item) =>
  'a' in item && item.a ? [{ q: item.q, a: item.a }] : [],
);
const unanswered = section.items.filter((item) => !('a' in item) || !item.a);
---

<section id="faq" class="bg-surface py-12 md:py-20">
  <Container>
    <SectionHeading title={section.title} description={section.description} />
    {/* TODO: implement visual */}
    <div class="mt-8">
      <FaqAccordion client:visible items={answered} />
      {unanswered.length > 0 ? (
        <ul class="mt-3 flex flex-col gap-3">
          {unanswered.map((item) => (
            <li class="rounded-lg bg-white px-4 py-3 ring-1 ring-line">
              <h3 class="text-lg font-semibold">{item.q}</h3>
            </li>
          ))}
        </ul>
      ) : null}
    </div>
    <p class="mt-6">
      <a
        class="inline-flex min-h-11 items-center font-semibold text-navy underline"
        href={externalLinks.helpCenter}
      >
        {section.helpCta}
      </a>
    </p>
  </Container>
</section>
