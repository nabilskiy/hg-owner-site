---
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';
import registrationUrl from '@/assets/getting-started/registration.svg?url';
import createUrl from '@/assets/getting-started/create.svg?url';
import publishUrl from '@/assets/getting-started/publish.svg?url';
import bookingsUrl from '@/assets/getting-started/bookings.svg?url';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const section = useTranslations(lang)('gettingStarted');

const visuals = [registrationUrl, createUrl, publishUrl, bookingsUrl];
---

<section id="getting-started" class="bg-canvas py-16 lg:py-24">
  <div class="mx-auto max-w-[1440px] px-8 lg:px-[84px]">
    <h2 class="max-w-[16ch] text-[40px] leading-[0.95] font-semibold tracking-[-0.03em] text-ink lg:text-[64px]">
      {section.title}
    </h2>
    <ol class="mt-12 grid gap-10 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-6">
      {section.steps.map((step, index) => (
        <li>
          <p class="text-center text-[56px] leading-none font-medium text-[#e4e8e8] lg:text-[72px]">
            {index + 1}
          </p>
          <h3 class="mt-2 text-center text-lg font-semibold tracking-[-0.02em] text-ink lg:text-xl">
            {step.title}
          </h3>
          <img
            src={visuals[index]}
            alt={step.title}
            width="294"
            height="220"
            class="mt-5 h-auto w-full"
          />
        </li>
      ))}
    </ol>
  </div>
</section>
