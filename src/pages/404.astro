---
import { defaultLocale, locales } from '@/i18n/config';
import { localizedPath, useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';

const t = useTranslations(defaultLocale);
const common = t('common');
const labels = {
  en: common.english,
  hr: common.croatian,
} as const;
---

<BaseLayout lang={defaultLocale} title={common.notFoundTitle} description={common.notFoundBody}>
  <Container>
    <div class="py-20">
      <h1 class="text-3xl font-semibold">{common.notFoundTitle}</h1>
      <p class="mt-3 text-muted">{common.notFoundBody}</p>
      <ul class="mt-6 flex gap-4">
        {locales.map((locale) => (
          <li>
            <a
              class="inline-flex min-h-11 items-center font-semibold underline"
              href={localizedPath(locale, '/')}
            >
              {labels[locale]}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Container>
</BaseLayout>
