---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  type?: 'button' | 'submit';
}

const { href, variant = 'primary', type = 'button' } = Astro.props;

const classes = [
  'inline-flex min-h-11 items-center justify-center rounded-pill px-5 text-lg font-semibold',
  variant === 'primary' ? 'bg-primary text-white' : 'bg-white text-navy ring-1 ring-navy',
];
---

{href ? (
  <a href={href} class:list={classes}>
    <slot />
  </a>
) : (
  <button type={type} class:list={classes}>
    <slot />
  </button>
)}
