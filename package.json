{
  "name": "holidayget-owner-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "infra:diff": "pnpm --filter infra diff",
    "infra:deploy": "pnpm --filter infra deploy",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,astro,css,json,md,yml,yaml}": "prettier --write",
    "*.{js,mjs,cjs,ts,tsx,astro}": "eslint --fix"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/outfit": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-tabs": "^1.1.22",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "embla-carousel-react": "^8.6.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3"
  }
}
